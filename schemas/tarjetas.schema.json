{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gonzalo-aragues.github.io/STUDY-APP/schemas/tarjetas.schema.json",
  "title": "Tarjetas de un tema (tarjetas.json)",
  "description": "Tarjetas de repaso espaciado. anverso y reverso admiten Markdown + LaTeX ($...$, $$...$$).",
  "type": "object",
  "additionalProperties": false,
  "required": ["asignatura", "tema", "fuente", "tarjetas"],
  "properties": {
    "$schema": { "type": "string" },
    "asignatura": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "tema": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "fuente": { "type": "string", "minLength": 1 },
    "tarjetas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tipo", "anverso", "reverso"],
        "properties": {
          "id": {
            "description": "Estable y único dentro del tema. NO cambiarlo: el historial de repaso va ligado a él.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "tipo": { "enum": ["concepto", "procedimiento"] },
          "anverso": { "type": "string", "minLength": 1 },
          "reverso": { "type": "string", "minLength": 1 },
          "etiquetas": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
