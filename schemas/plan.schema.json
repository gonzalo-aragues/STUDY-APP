{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gonzalo-aragues.github.io/STUDY-APP/schemas/plan.schema.json",
  "title": "Plan de estudio (plan/plan.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["generado", "desde", "hasta", "semanas"],
  "properties": {
    "$schema": { "type": "string" },
    "generado": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "desde": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "hasta": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "horasPorDia": { "type": "number" },
    "notas": { "type": "array", "items": { "type": "string" } },
    "semanas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inicio", "fin", "titulo", "dias"],
        "properties": {
          "inicio": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "fin": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "titulo": { "type": "string" },
          "objetivo": { "type": "string" },
          "dias": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fecha", "items"],
              "properties": {
                "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "horas": { "type": "number", "minimum": 0 },
                "nota": { "type": "string" },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["asignatura", "tipo", "texto"],
                    "properties": {
                      "asignatura": { "type": "string" },
                      "tema": { "type": "string" },
                      "tipo": { "enum": ["aprender", "practicar", "repasar", "simulacro", "examen", "preparar", "descanso"] },
                      "texto": { "type": "string" },
                      "horas": { "type": "number", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
