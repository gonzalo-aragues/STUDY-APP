{
  "name": "study-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Material de estudio + app de repaso espaciado (PWA) para todo el grado.",
  "scripts": {
    "validate": "node scripts/validate.ts",
    "build-index": "node scripts/build-index.ts",
    "dev": "npm run build-index && vite",
    "build": "npm run validate && npm run build-index && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "nueva-asignatura": "node scripts/nueva-asignatura.ts",
    "nuevo-semestre": "node scripts/nuevo-semestre.ts",
    "plan": "node scripts/generar-plan.ts",
    "screenshots": "node scripts/screenshots.ts",
    "check-code": "node scripts/check-code.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.2.7",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "ts-fsrs": "^5.4.2"
  }
}
